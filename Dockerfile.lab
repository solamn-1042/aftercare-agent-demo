FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 CASE_DB=/data/cases.sqlite3
WORKDIR /app
RUN useradd --uid 10001 --create-home app && mkdir /data && chown app:app /data
COPY requirements-lab.txt .
RUN pip install --no-cache-dir -r requirements-lab.txt
COPY --chown=app:app lab/ lab/
COPY --chown=app:app evals/ evals/
USER 10001
EXPOSE 8001
CMD ["python","-m","uvicorn","lab.app:app","--host","0.0.0.0","--port","8001","--workers","1","--limit-concurrency","16"]
